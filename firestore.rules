rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - role: string (required, 'user' or 'admin')
    //   - createdAt: timestamp (required)
    //   - info: string (optional)
    //   - topic: string (optional)
    //   - format: string (optional)
    //   - documentContent: string (optional)
    //   - transcript: list (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: users/{userId}/projects
    // Document ID: {projectId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - name: string (required)
    //   - documentContent: string (required)
    //   - transcript: list (required)
    //   - updatedAt: timestamp (required)
    //   - createdAt: timestamp (optional)
    //
    // Collection: users/{userId}/projects/{projectId}/versions
    // Document ID: {versionId}
    // Fields:
    //   - id: string (required)
    //   - documentContent: string (required)
    //   - createdAt: timestamp (required)
    //   - label: string (optional)
    //
    // Collection: interviews
    // Document ID: {interviewId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - title: string (required)
    //   - goal: string (required)
    //   - questions: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: interviews/{interviewId}/responses
    // Document ID: {responseId}
    // Fields:
    //   - id: string (required)
    //   - transcript: list (required)
    //   - summary: string (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "prettyinpurple2021@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidList(field, maxSize) {
      return request.resource.data[field] is list && request.resource.data[field].size() <= maxSize;
    }

    function isValidOptionalList(field, maxSize) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is list && request.resource.data[field].size() <= maxSize);
    }

    function isTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    function isOptionalTimestamp(field) {
      return !(field in request.resource.data) || request.resource.data[field] is timestamp;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser() {
      let allowedFields = ['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'info', 'topic', 'format', 'documentContent', 'transcript', 'updatedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             isValidString('uid', 1, 100) &&
             isValidString('email', 3, 100) &&
             isValidOptionalString('displayName', 0, 100) &&
             isValidOptionalString('photoURL', 0, 500) &&
             request.resource.data.role in ['user', 'admin'] &&
             isOptionalTimestamp('createdAt') &&
             isValidOptionalString('info', 0, 5000) &&
             isValidOptionalString('topic', 0, 1000) &&
             isValidOptionalString('format', 0, 100) &&
             isValidOptionalString('documentContent', 0, 1000000) && // 1MB limit
             isValidOptionalList('transcript', 10000) &&
             isOptionalTimestamp('updatedAt');
    }

    function isValidProject() {
      let allowedFields = ['id', 'userId', 'name', 'documentContent', 'transcript', 'updatedAt', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['id', 'userId', 'name', 'documentContent', 'transcript', 'updatedAt']) &&
             isValidString('id', 1, 100) &&
             isValidString('userId', 1, 100) &&
             isValidString('name', 1, 200) &&
             isValidString('documentContent', 0, 1000000) &&
             isValidList('transcript', 10000) &&
             isTimestamp('updatedAt') &&
             isOptionalTimestamp('createdAt');
    }

    function isValidInterview() {
      let allowedFields = ['id', 'userId', 'title', 'goal', 'questions', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('id', 1, 100) &&
             isValidString('userId', 1, 100) &&
             isValidString('title', 1, 200) &&
             isValidString('goal', 1, 5000) &&
             isValidString('questions', 1, 10000) &&
             isTimestamp('createdAt');
    }

    function isValidInterviewResponse() {
      let allowedFields = ['id', 'transcript', 'summary', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('id', 1, 100) &&
             isValidList('transcript', 10000) &&
             isValidString('summary', 0, 50000) &&
             isTimestamp('createdAt');
    }

    function isValidVersion() {
      let allowedFields = ['id', 'documentContent', 'createdAt', 'label'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['id', 'documentContent', 'createdAt']) &&
             isValidString('id', 1, 100) &&
             isValidString('documentContent', 0, 1000000) &&
             isTimestamp('createdAt') &&
             isValidOptionalString('label', 0, 200);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can only read their own data
      allow read: if isOwner(userId);
      
      // Users can create their own profile. They cannot create an admin role unless they are already an admin.
      allow create: if isOwner(userId) && isValidUser() && 
                    ((request.resource.data.role == 'user') || isAdmin());
                    
      // Users can update their own profile. They cannot change their role unless they are an admin.
      // They cannot change their uid.
      allow update: if isOwner(userId) && isValidUser() && 
                    areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
                    ((!('role' in request.resource.data) || request.resource.data.role == resource.data.role) || isAdmin());
                    
      allow delete: if isOwner(userId) || isAdmin();

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        
        // Ensure the userId inside the document matches the path userId
        allow create: if isOwner(userId) && isValidProject() && request.resource.data.userId == userId;
        
        allow update: if isOwner(userId) && isValidProject() && 
                      areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
                      
        allow delete: if isOwner(userId);

        match /versions/{versionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidVersion();
          allow update, delete: if isOwner(userId) || isAdmin();
        }
      }
    }

    match /interviews/{interviewId} {
      // Anyone can read an interview to take it
      allow read: if true;
      
      // Only authenticated users can create an interview, and they must set themselves as the owner
      allow create: if isAuthenticated() && isValidInterview() && request.resource.data.userId == request.auth.uid;
      
      // Only the owner can update or delete
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidInterview() &&
                    areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
                    
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /responses/{responseId} {
        // Only the owner of the interview can read the responses
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/interviews/$(interviewId)).data.userId == request.auth.uid;
        
        // Anyone can submit a response
        allow create: if isValidInterviewResponse();
        
        // Responses cannot be updated or deleted by public users
        allow update, delete: if false;
      }
    }
  }
}
