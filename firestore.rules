rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - role: string (required, 'admin' or 'user')
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: users/{userId}/projects
    // Document ID: {projectId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - name: string (required)
    //   - documentContent: string (required)
    //   - transcript: list of objects (optional)
    //   - updatedAt: timestamp (required)
    //   - createdAt: timestamp (required, immutable)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "prettyinpurple2021@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    function isValidTranscript(transcript) {
      return transcript is list && transcript.size() < 10000;
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'info', 'topic', 'format', 'documentContent', 'transcript']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             (!('info' in data) || (data.info is string && data.info.size() < 10000)) &&
             (!('topic' in data) || (data.topic is string && data.topic.size() < 1000)) &&
             (!('format' in data) || (data.format in ['Markdown', 'HTML'])) &&
             (!('documentContent' in data) || (data.documentContent is string && data.documentContent.size() < 1000000)) &&
             (!('transcript' in data) || isValidTranscript(data.transcript)) &&
             data.role in ['admin', 'user'] &&
             data.createdAt is timestamp;
    }
    
    function isValidProject(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'name', 'documentContent', 'transcript', 'updatedAt', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.documentContent is string && data.documentContent.size() < 1000000 &&
             (!('transcript' in data) || isValidTranscript(data.transcript)) &&
             data.updatedAt is timestamp &&
             data.createdAt is timestamp;
    }

    function isValidInterview(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'title', 'goal', 'questions', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.userId is string && data.userId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.goal is string && data.goal.size() > 0 && data.goal.size() < 5000 &&
             data.questions is string && data.questions.size() > 0 && data.questions.size() < 5000 &&
             data.createdAt is timestamp;
    }

    function isValidResponse(data) {
      return hasOnlyAllowedFields(['id', 'transcript', 'summary', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.transcript is list && data.transcript.size() < 10000 &&
             data.summary is string && data.summary.size() < 10000 &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged() && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && (request.resource.data.role == resource.data.role || isAdmin()) && request.resource.data.createdAt == resource.data.createdAt;
      
      match /projects/{projectId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated() && isOwner(userId) && isValidProject(request.resource.data) && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && isOwner(userId) && isValidProject(request.resource.data) && request.resource.data.userId == resource.data.userId && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /interviews/{interviewId} {
      // Anyone can read an interview to participate in it
      allow read: if true;
      allow create: if isAuthenticated() && isValidInterview(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidInterview(request.resource.data) && request.resource.data.userId == resource.data.userId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /responses/{responseId} {
        // Anyone can submit a response
        allow create: if isValidResponse(request.resource.data);
        // Only the creator of the interview can read/update/delete the responses
        allow read, update, delete: if isAuthenticated() && get(/databases/$(database)/documents/interviews/$(interviewId)).data.userId == request.auth.uid;
      }
    }
  }
}
